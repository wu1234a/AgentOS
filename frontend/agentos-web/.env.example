# Vite dev server proxies /health and /api to http://localhost:5000 by default.
# Set this only when the API is hosted on another origin.
VITE_API_BASE_URL=

# Development-only API client key (header X-AgentOS-Dev-Key). Must match
# Authentication:DevelopmentApiKey on the API. Never put a production secret here.
VITE_DEV_API_KEY=
