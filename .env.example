# Backend environment: set these as shell environment variables or dotnet user-secrets.
# .NET does not read .env files by default; never commit real secrets.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__AgentOS=Server=lpc:localhost;Database=AgentOS_Dev;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=3
# Development-only API client key. Set it via user-secrets or your shell; never commit a real key.
Authentication__DevelopmentApiKey=
Events__MaxRequestBodyBytes=262144

# Frontend environment: see frontend/agentos-web/.env.example
# VITE_API_BASE_URL=
