    "ClaimBatchLimit": 10,
    "RecoveryIntervalSeconds": 30
  },
  "Runner": {
    "RegistrationKey": ""
  },
  "Skills": {
    "RootPath": "",
    "MaxBytes": 65536
  },
  "BrowserAutomation": {
    "Enabled": false,
    "Headless": true,
    "TimeoutSeconds": 30,
    "AllowedHosts": [],
