{
  "Events": {
    "MaxRequestBodyBytes": 262144
  },
  "TaskQueue": {
    "LeaseDurationSeconds": 90,
    "HeartbeatIntervalSeconds": 20,
    "TaskTimeoutSeconds": 1800,
    "MaxAttempts": 2,
    "BackoffBaseSeconds": 30,
    "BackoffMaxSeconds": 900,
    "ClaimBatchLimit": 10,
    "RecoveryIntervalSeconds": 30
  },
  "Runner": {
    "RegistrationKey": ""
  },
  "Skills": {
    "RootPath": "",
    "MaxBytes": 65536
  },
  "BrowserAutomation": {
    "Enabled": false,
    "Headless": true,
    "TimeoutSeconds": 30,
    "AllowedHosts": [],
    "ScreenshotDirectory": "browser-screenshots"
  },
  "Knowledge": {
    "Embedding": {
      "Enabled": false,
      "BaseUrl": null,
      "ApiKey": null,
      "Model": "text-embedding-3-small"
    }
  },
  "Usage": {
    "Pricing": {}
  },
  "GitHub": {
    "Enabled": false,
    "WebhookSecret": null,
    "AllowedRepositories": [],
    "AllowedEvents": [ "pull_request", "push", "workflow_run" ],
    "RepositoryProjects": {}
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": null,
    "AllowedChatIds": [],
    "AllowedUserIds": [],
    "PollTimeoutSeconds": 30,
    "NotificationChatId": 0,
    "MaxSendAttempts": 5
  },
  "Planner": {
    "DefaultModelProfileCode": "kimi-planner",
    "AllowedProviderHosts": [ "api.moonshot.cn", "api.openai.com" ],
    "MaxGoalCharacters": 4000,
    "MaxContextCharacters": 8000,
    "MaxDraftCharacters": 100000
  },
  "Artifacts": {
    "RootPath": "",
    "MaxBytes": 10485760,
    "AllowedMediaTypes": [ "text/plain", "text/markdown", "application/json", "application/octet-stream", "image/png", "image/jpeg" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
