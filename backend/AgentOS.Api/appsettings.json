  "Usage": {
    "Pricing": {}
  },
  "GitHub": {
    "Enabled": false,
    "WebhookSecret": null,
    "AllowedRepositories": [],
    "AllowedEvents": [ "pull_request", "push", "workflow_run" ],
    "RepositoryProjects": {},
    "ReviewEnabled": false,
    "ReviewToken": null,
    "MaxReviewAttempts": 5,
    "AutoMerges": {
      "wu1234a/3dERP": {
        "Enabled": false,
        "BaseBranch": "main",
        "BranchPrefix": "aos/",
        "MergeMethod": "squash",
        "PollSeconds": 30,
        "RequireReview": true
      }
    }
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": null,
    "AllowedChatIds": [],
    "AllowedUserIds": [],
    "PollTimeoutSeconds": 30,
    "NotificationChatId": 0,
    "MaxSendAttempts": 5
  },
  "Planner": {
    "DefaultModelProfileCode": "kimi-planner",
    "AllowedProviderHosts": [ "api.moonshot.cn", "api.openai.com", "api.deepseek.com", "open.bigmodel.cn", "dashscope.aliyuncs.com", "ark.cn-beijing.volces.com", "api.hunyuan.cloud.tencent.com", "api.x.ai" ],
    "MaxGoalCharacters": 4000,
    "MaxContextCharacters": 8000,
    "MaxDraftCharacters": 100000,
    "AutoDispatch": {
      "Enabled": false,
      "ProjectSlug": "3derp",
      "Source": "planner",
      "EventType": "draft.approved",
      "ValidationCommands": [
        "dotnet build 3dERP.slnx",
        "dotnet test 3dERP.slnx --no-build",
        "npm --prefix web ci",
        "npm --prefix web run build"
      ],
      "Delivery": {
        "Repository": "wu1234a/3dERP",
        "BaseBranch": "main",
        "Remote": "origin",
        "TokenEnvironmentVariable": "AGENTOS_GITHUB_TOKEN",
        "RequirePullRequest": true
      }
    }
  },
  "Backlog": {
    "Enabled": false,
    "PollSeconds": 15,
    "MaxRepairAttempts": 1
  },
  "Review": {
    "Provider": "glm",
    "Model": "glm-5.3",
    "BaseUrl": "https://open.bigmodel.cn/api/paas/v4",
    "SecretReference": "ZHIPU_API_KEY",
    "TimeoutSeconds": 600
  },
  "Artifacts": {
    "RootPath": "",
    "MaxBytes": 10485760,
    "AllowedMediaTypes": [ "text/plain", "text/markdown", "application/json", "application/octet-stream", "image/png", "image/jpeg" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
