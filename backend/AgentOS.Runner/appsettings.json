{
  "Runner": {
    "AgentAdapter": "demo",
    "BaseUrl": "http://localhost:5080",
    "WorkerCode": "local-runner",
    "DisplayName": "Local Runner",
    "HostName": "localhost",
    "Platform": "Windows",
    "Architecture": "x64",
    "Version": "1.0.0",
    "WorkspaceRoots": [
      "E:\\Projects"
    ],
    "Projects": [
      {
        "Slug": "example-project",
        "Path": "E:\\Projects\\example-project"
      }
    ],
    "PollIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 20,
    "MaxConcurrentTasks": 2,
    "RequestTimeoutSeconds": 30,
    "MaxLogEntriesPerBatch": 50,
    "RegistrationKey": "",
    "ClientId": "",
    "ClientSecret": "",
    "DevApiKey": ""
  },
  "Codex": {
    "ExecutablePath": "codex",
    "SandboxMode": "read-only",
    "Model": "",
    "TimeoutSeconds": 900,
    "MaxOutputBytes": 2000000,
    "CliVersionConstraint": ">=0.166.0",
    "EnvironmentAllowList": [
      "PATH", "PATHEXT", "HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "TEMP", "TMP",
      "SYSTEMROOT", "WINDIR", "COMSPEC", "LANG", "LC_ALL", "TERM",
      "HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY", "ALL_PROXY",
      "OPENAI_API_KEY", "CODEX_HOME", "SSL_CERT_FILE"
    ],
    "RedactEnvironmentVariables": [ "OPENAI_API_KEY" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
