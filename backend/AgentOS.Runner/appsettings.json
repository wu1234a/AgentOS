{
  "Runner": {
    "BaseUrl": "http://localhost:5080",
    "WorkerCode": "local-runner",
    "DisplayName": "Local Runner",
    "HostName": "localhost",
    "Platform": "Windows",
    "Architecture": "x64",
    "Version": "1.0.0",
    "WorkspaceRoots": [
      "E:\\Projects"
    ],
    "Projects": [
      {
        "Slug": "example-project",
        "Path": "E:\\Projects\\example-project"
      }
    ],
    "PollIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 20,
    "MaxConcurrentTasks": 2,
    "RequestTimeoutSeconds": 30,
    "MaxLogEntriesPerBatch": 50,
    "RegistrationKey": "",
    "ClientId": "",
    "ClientSecret": "",
    "DevApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
