{
  "_comment": "Copy to appsettings.json and replace placeholders. Never commit real secrets; prefer environment variables: Runner__RegistrationKey, Runner__ClientId, Runner__ClientSecret.",
  "Runner": {
    "AgentAdapter": "multi",
    "BaseUrl": "https://agentos.example.internal",
    "WorkerCode": "local-runner-01",
    "DisplayName": "Local Runner 01",
    "HostName": "<machine-name>",
    "Platform": "Windows",
    "Architecture": "x64",
    "Version": "1.0.0",
    "WorkspaceRoots": [
      "D:\\AgentOS\\workspaces"
    ],
    "Projects": [
      {
        "Slug": "my-project",
        "Path": "D:\\AgentOS\\workspaces\\my-project"
      }
    ],
    "PollIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 20,
    "MaxConcurrentTasks": 2,
    "RequestTimeoutSeconds": 30,
    "MaxLogEntriesPerBatch": 50,
    "RegistrationKey": "<one-time-bootstrap-key>",
    "ClientId": "",
    "ClientSecret": "",
    "DevApiKey": ""
  },
  "Codex": {
    "ExecutablePath": "C:\\Users\\<user>\\AppData\\Local\\OpenAI\\Codex\\bin\\codex.exe",
    "SandboxMode": "workspace-write",
    "Model": "",
    "TimeoutSeconds": 900,
    "MaxOutputBytes": 2000000,
    "CliVersionConstraint": ">=0.166.0",
    "EnvironmentAllowList": [
      "PATH", "PATHEXT", "HOME", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "TEMP", "TMP",
      "SYSTEMROOT", "WINDIR", "COMSPEC", "LANG", "LC_ALL", "TERM",
      "HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY", "ALL_PROXY",
      "OPENAI_API_KEY", "CODEX_HOME", "SSL_CERT_FILE"
    ],
    "RedactEnvironmentVariables": [ "OPENAI_API_KEY" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
